# ============================================================
# KEKG 后端环境变量模板
# 用法：复制为 .env 后按实际环境修改（.env 已被 .gitignore 忽略，切勿提交）
#   Windows: copy .env.example .env
#   Linux/macOS: cp .env.example .env
# ============================================================

# ---------- 安全 ----------
# 必填，长度 >= 16，否则启动直接失败
# 生成方式：python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=请替换为随机字符串_至少16位
JWT_EXPIRE_DAYS=7

# ---------- MySQL ----------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=请替换为你的MySQL密码
MYSQL_DATABASE=kekg_db

# ---------- Neo4j ----------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=请替换为你的Neo4j密码

# ---------- 账号与邀请 ----------
# 首次启动创建默认 admin 时使用（自行设置一个强密码，留空则不会自动创建 admin）
ADMIN_DEFAULT_PASSWORD=
# 注册 / 管理员建号时校验的邀请码（自行设置）
DEFAULT_INVITE_CODE=

# ---------- LLM（可选，留空则 AI 功能不可用） ----------
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_ENCODE_KEY=

# ---------- CORS 白名单（逗号分隔；为空时仅允许本地开发地址） ----------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------- 演示环境专项开关 ----------
# SKIP_SQL_META=1：导入赛道图谱时只写 Neo4j，不再同步写入 MySQL 的
#   knowledge_points_meta / relationship_meta 镜像表。
#   演示环境若已用 database/seed_demo.sql 灌入这两张表，必须设为 1，
#   否则二次导入会产生重复数据，导致统计翻倍。
#   生产环境 / 从零构建图谱时保持 0（默认），让双写生效。
SKIP_SQL_META=0
